{
  "manifest_version": 3,
  "name": "CIVEX CiteRunner Local",
  "version": "1.0.0",
  "description": "Instant one-click BibTeX/APA citation generator for academic papers and docs.",
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CIVEX CiteRunner Local"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "kernel.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "https://*.arxiv.org/*",
    "https://*.nature.com/*",
    "https://*.ieee.org/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}