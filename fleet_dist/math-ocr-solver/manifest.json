{
  "manifest_version": 3,
  "name": "CIVEX Math OCR Solver",
  "version": "1.0.0",
  "description": "Evaluates on-screen calculus, matrix equations, and complex circuits locally.",
  "permissions": [
    "activeTab",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CIVEX Math OCR Solver"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "kernel.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}